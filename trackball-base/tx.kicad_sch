  (text "NOTES:"
    (at 12.70 195.58 0)
    (effects
        (font
          (size 1.524 1.524)
        )
        (justify left top))
    (uuid "373396ec-cbc8-4534-b9c0-26d5dac3737c")
  )
  (text "1. LTC4125EUFD per datasheet Fig 7 (4125f), retuned for ~1W TX (PWR-001):"
    (at 12.70 201.93 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "670f801b-44c1-42fc-89d8-7b29dfa3abef")
  )
  (text "   RIS=100m, RIN=13.0k, RIMON=348k -> ITH=300mA, ILIM=450mA."
    (at 12.70 207.01 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "65e71468-b9b8-4f19-ba89-fb997b73d89c")
  )
  (text "2. Tank 24uH + 100nF C0G -> ~103kHz; FTH div -> 119kHz FOD limit;"
    (at 12.70 212.09 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "a16287d8-0d38-409e-bddb-7ff7511f7a20")
  )
  (text "   DTH div per Fig 7 (bench-tune step size for 1W if search stalls)."
    (at 12.70 217.17 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "d249bbf0-90c5-4567-9fc0-3d41138408f5")
  )
  (text "3. TX_EN HIGH = driver DISABLED (EN pin). FW: drive low to run TX;"
    (at 12.70 222.25 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "dfef4a85-926c-4663-8e36-1c1085cf843a")
  )
  (text "   rail gated by MCU_TX_EN on power sheet; TX off until enumerated."
    (at 12.70 227.33 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "f39132e2-2175-4ffa-b917-519bf3f6f46c")
  )
  (text "4. STAT open-drain -> TX_STAT to MCU (10k PU). Ref DSTAT LED omitted."
    (at 12.70 232.41 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "126bc27d-c452-44b8-9058-7426295cb5fc")
  )
  (text "5. PTH1/PTH2 open per Fig 7 (NC). PTHM=GND -> min pulse 1/32 period."
    (at 12.70 237.49 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "5ad1b646-5b10-49a1-a3e0-ed362e56f22e")
  )
  (text "6. NTC 100k + 10k -> 41.5C coil limit (Fig 7). TH501 AT the TX coil."
    (at 12.70 242.57 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "340747ab-15a9-491a-8fc0-05aea0248263")
  )
  (text "7. CTX 100V C0G, RFB1 100V, DFB BAS521: tank peaks are high voltage."
    (at 12.70 247.65 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "c4258be9-b361-4efe-8195-1f3a3ad2cb04")
  )
  (text "8. TX_IMON -> MCU ADC: FW TACQ>=10us (348k source impedance)."
    (at 12.70 252.73 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "882c50ea-02cf-4a60-a5e6-c01809aaa267")
  )
  (text "9. DC1 clamps FB node to VIN. CDBQR70 pkg to verify at BOM (alt BAT54)."
    (at 12.70 257.81 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "ca4035f6-ea93-47fa-b810-950e522f1c58")
  )
