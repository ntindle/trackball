  (text "NOTES:"
    (at 12.70 195.58 0)
    (effects
        (font
          (size 1.524 1.524)
        )
        (justify left top))
    (uuid "c812712d-217e-4dbd-a8a7-0ff9e5825c2b")
  )
  (text "1. LTC4125EUFD per datasheet Fig 7 (4125f), PWR-001 nominals:"
    (at 12.70 201.93 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "2888f813-31de-40e5-bfd0-0567bb2c2249")
  )
  (text "   RIS=100m, RIN=10k, RIMON=267k -> ITH=300mA, ILIM=450mA; 3x47uF>=100uF."
    (at 12.70 207.01 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "a70d6584-93da-470b-b277-0bd9f03165f7")
  )
  (text "2. Tank 24uH + 100nF C0G -> ~103kHz; FTH div -> 119kHz FOD limit;"
    (at 12.70 212.09 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "1fb4ec11-64aa-4670-8292-33953bced79a")
  )
  (text "   DTH div per Fig 7 (bench-tune step size for 1W if search stalls)."
    (at 12.70 217.17 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "5b99f34f-cc07-4074-9858-a298dd2074b8")
  )
  (text "3. TX_EN HIGH = driver DISABLED (EN pin); R508 PU to VIN holds OFF by default (PWR-001)."
    (at 12.70 222.25 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "750f3bb0-c6cf-45d3-a1a6-51e2578fb094")
  )
  (text "   FW: drive low to run TX (after enum + rail on); high/Hi-Z to stop; stop if VBUS<4.4V."
    (at 12.70 227.33 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "9b975ee5-5ca1-491c-9efd-bd3ecc65576d")
  )
  (text "4. STAT open-drain -> TX_STAT to MCU (10k PU). Ref DSTAT LED omitted."
    (at 12.70 232.41 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "9ae75444-61b0-41b7-81c7-98ce9d8ae7b3")
  )
  (text "5. PTH1/PTH2 open per Fig 7 (NC). PTHM=GND -> min pulse 1/32 period."
    (at 12.70 237.49 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "61dd8b2f-5463-447c-857a-d5f80e1bb6d2")
  )
  (text "6. NTC 100k + 10k -> 41.5C coil limit (Fig 7). TH501 AT the TX coil."
    (at 12.70 242.57 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "04b8ba36-4aa1-447b-a424-c614861bbd98")
  )
  (text "7. CTX 100V C0G, RFB1 100V, DFB BAS521: tank peaks are high voltage."
    (at 12.70 247.65 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "10b6dcec-577a-4375-a5b7-7c998f54c1b0")
  )
  (text "8. TX_IMON -> MCU ADC: FW TACQ>=10us (267k source impedance)."
    (at 12.70 252.73 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "7ae9e262-fe1c-4536-a67a-ef99a88ad5ac")
  )
  (text "9. DC1 clamps FB node to VIN. CDBQR70 pkg to verify at BOM (alt BAT54)."
    (at 12.70 257.81 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "603aef09-9e1a-4c0a-ad99-4669ed3faf91")
  )
