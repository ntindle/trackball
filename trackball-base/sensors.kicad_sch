  (text "rail flags: drivers on power sheet"
    (at 181.61 149.86 0)
    (effects
        (font
          (size 1.0 1.0)
        )
        (justify left top))
    (uuid "c7412e06-6342-4d97-a103-a7c8654c0ad4")
